# =====================================================================
# HT9046MX Analytics Stack - Environment Configuration Template
# For deployment on Server with deployment/docker-compose.analytics.yml
# Copy this file to deployment/.env.analytics and fill in credentials.
# =====================================================================

# App mode: 'live' for server connection, 'demo' for offline verified preview
HT9046MX_APP_MODE=live
HT9046MX_PROJECT_ROOT=/opt/OPERATION_P
HT9046MX_API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# =====================================================================
# 1. Analytics MySQL Database (Target host: 10.195.17.73)
# Stores shadow scores, alert episodes, calibration registry, technician labels
# =====================================================================
HT9046MX_ANALYTICS_DB_HOST=10.195.17.73
HT9046MX_ANALYTICS_DB_PORT=3306
HT9046MX_ANALYTICS_DB_NAME=ht9046mx_analytics
HT9046MX_ANALYTICS_DB_USER=REPLACE_WITH_ANALYTICS_USER
HT9046MX_ANALYTICS_DB_PASSWORD=REPLACE_WITH_ANALYTICS_PASSWORD

# =====================================================================
# 2. Raw Telemetry Source Database (Read-Only)
# Polled by built-in calibration worker. Must have SELECT-only permission.
# =====================================================================
HT9046MX_SOURCE_DB_HOST=REPLACE_WITH_SOURCE_HOST
HT9046MX_SOURCE_DB_PORT=3306
HT9046MX_SOURCE_DB_NAME=ht9046mx_iot
HT9046MX_SOURCE_DB_USER=REPLACE_WITH_READONLY_USER
HT9046MX_SOURCE_DB_PASSWORD=REPLACE_WITH_READONLY_PASSWORD
HT9046MX_SOURCE_TABLE=ht9046mx_readings
HT9046MX_SOURCE_TIMESTAMP_COLUMN=recorded_at
HT9046MX_SOURCE_MACHINE_COLUMN=machine_number
HT9046MX_SOURCE_GLOBAL_STATUS_COLUMN=Status
HT9046MX_SOURCE_HP1_TEMPLATE=Hp_1st_{module}
HT9046MX_SOURCE_LP1_TEMPLATE=Lp_1st_{module}
HT9046MX_SOURCE_HP2_TEMPLATE=Hp_2nd_{module}
HT9046MX_SOURCE_LP2_TEMPLATE=Lp_2nd_{module}
HT9046MX_SOURCE_VALVE_TEMPLATE=Valve_{module}
HT9046MX_SOURCE_TEMP_HIGH_TEMPLATE=TempHi_{module}
HT9046MX_SOURCE_TEMP_LOW_TEMPLATE=TempLo_{module}
HT9046MX_SOURCE_MODULE_STATUS_TEMPLATE=Status_{module}
HT9046MX_SOURCE_BUSY_TEMPLATE=Busy_{module}
HT9046MX_SOURCE_SV_TEMPLATE=SV_{module}

# State gate mapping: Compressor ON is 'Run'; Busy=1 is service/manual; SV=Off is cold mode.
HT9046MX_SOURCE_COMPRESSOR_ON_STATUS=Run
HT9046MX_SOURCE_MODULE_ON_STATUS=On
HT9046MX_SOURCE_BUSY_NORMAL_VALUES=0,False,Off
HT9046MX_SOURCE_SV_OFF_VALUES=Off,0,False
# Set only after source owner confirms the source timestamp clock.
HT9046MX_SOURCE_TIMEZONE=
# Set only after source owner confirms gauge versus absolute pressure units.
HT9046MX_SOURCE_PRESSURE_UNIT=

# New observed-second -> one-minute path is preview-only; do not enable until
# source cadence/timezone and exact-window profile version are reviewed.
HT9046MX_QUALIFIED_1M_PREVIEW_ENABLED=false
HT9046MX_SOURCE_EXPECTED_CADENCE_SECONDS=1.0
HT9046MX_QUALIFIED_1M_MINIMUM_COVERAGE=0.95
HT9046MX_QUALIFIED_1M_MAXIMUM_GAP_SECONDS=5.0
HT9046MX_QUALIFIED_1M_LATE_ARRIVAL_SECONDS=30.0

# =====================================================================
# 3. System Cadence & Alert Feedback Boundary
# =====================================================================
HT9046MX_DASHBOARD_REFRESH_MINUTES=5
HT9046MX_SCORING_INTERVAL_MINUTES=1
# Start timestamp for prospective technician feedback (new alerts only)
# Leave unset until the prospective start instant is formally approved.
# HT9046MX_TECHNICIAN_FEEDBACK_START_AT=<APPROVED_ISO8601_WITH_OFFSET>
# Confirmed IANA timezone of ht9046mx_shadow_alert_episode.detected_at
HT9046MX_ALERT_DATETIME_TIMEZONE=

# =====================================================================
# 4. Built-in Candidate Calibration Worker
# Reads historical source MySQL, fits candidate profile, shadows 3 days.
# Creates candidates only; promotion requires human approval via API/UI.
# =====================================================================
# Keep disabled until source time/unit/codebook/service evidence is confirmed.
HT9046MX_PROFILE_CANDIDATE_ENABLED=false
HT9046MX_PROFILE_WINDOW_CONTRACT=qualified_observed_1m
HT9046MX_PROFILE_HISTORY_DAYS=30
HT9046MX_PROFILE_SHADOW_DAYS=3
HT9046MX_PROFILE_MIN_CALIBRATION_DAYS=7
HT9046MX_PROFILE_MIN_CALIBRATION_WINDOWS=200
HT9046MX_PROFILE_MIN_SHADOW_WINDOWS=200
HT9046MX_PROFILE_RETRY_MIN_NEW_DAYS=3
# These must be real approved version identifiers, not plausible examples.
HT9046MX_PROFILE_STATE_CONTRACT_VERSION=
HT9046MX_PROFILE_CONTROLLER_CODEBOOK_VERSION=
HT9046MX_PROFILE_SERVICE_EPOCH_VERSION=

# Schedules (Cron expressions)
HT9046MX_PROFILE_CANDIDATE_CRON=0 2 * * *
HT9046MX_MODEL_CANDIDATE_CRON=0 3 * * 0
HT9046MX_SHADOW_SCORE_CRON=* * * * *
# Owner-selected rule-only path; no ARX/model candidate command.
HT9046MX_MODEL_CANDIDATE_COMMAND=
# Keep the runtime command blank until one-minute/profile parity acceptance.
HT9046MX_SHADOW_SCORE_COMMAND=

# Durable raw-second -> 1m -> Episode -> PM evidence worker. Start in shadow.
HT9046MX_DETECTOR_WORKER_ENABLED=false
HT9046MX_DETECTOR_FLEET_SHADOW_ENABLED=false
HT9046MX_DETECTOR_CRON=*/5 * * * *
HT9046MX_DETECTOR_SHADOW_ONLY=true
HT9046MX_DETECTOR_MACHINES=
HT9046MX_DETECTOR_SOURCE_ID_COLUMN=id
HT9046MX_DETECTOR_OVERLAP_MINUTES=30
HT9046MX_DETECTOR_MAX_SOURCE_ROWS=10000
HT9046MX_DETECTOR_BRIDGE_ENABLED=false
HT9046MX_DETECTOR_ALERTS_ENABLED=false
# Severity routing only, not an anomaly threshold or a probability.
HT9046MX_DETECTOR_CRITICAL_SCORE_RATIO=2.0
HT9046MX_DETECTOR_PM_DB_HOST=10.195.17.73
HT9046MX_DETECTOR_PM_DB_PORT=3306
HT9046MX_DETECTOR_PM_DB_NAME=predictive_maintenance
HT9046MX_DETECTOR_PM_DB_USER=REPLACE_WITH_PM_BRIDGE_USER
HT9046MX_DETECTOR_PM_DB_PASSWORD=REPLACE_WITH_PM_BRIDGE_PASSWORD
