HT9046MX_APP_MODE=demo
HT9046MX_PROJECT_ROOT=/opt/OPERATION_P
HT9046MX_API_CORS_ORIGINS=http://localhost:5173

# Analytics MySQL only. Keep the real password in the Server secret store.
HT9046MX_ANALYTICS_DB_HOST=10.195.17.73
HT9046MX_ANALYTICS_DB_PORT=3306
HT9046MX_ANALYTICS_DB_NAME=ht9046mx_analytics
HT9046MX_ANALYTICS_DB_USER=
HT9046MX_ANALYTICS_DB_PASSWORD=

# Raw telemetry is read-only and may be on another host. Confirm every mapping
# with the server owner before enabling the built-in calibration worker.
HT9046MX_SOURCE_DB_HOST=
HT9046MX_SOURCE_DB_PORT=3306
HT9046MX_SOURCE_DB_NAME=ht9046mx_iot
HT9046MX_SOURCE_DB_USER=
HT9046MX_SOURCE_DB_PASSWORD=
HT9046MX_SOURCE_TABLE=ht9046mx_readings
HT9046MX_SOURCE_TIMESTAMP_COLUMN=recorded_at
HT9046MX_SOURCE_MACHINE_COLUMN=machine_number
HT9046MX_SOURCE_GLOBAL_STATUS_COLUMN=Status
HT9046MX_SOURCE_HP1_TEMPLATE=Hp_1st_{module}
HT9046MX_SOURCE_LP1_TEMPLATE=Lp_1st_{module}
HT9046MX_SOURCE_HP2_TEMPLATE=Hp_2nd_{module}
HT9046MX_SOURCE_LP2_TEMPLATE=Lp_2nd_{module}
HT9046MX_SOURCE_VALVE_TEMPLATE=Valve_{module}
HT9046MX_SOURCE_TEMP_HIGH_TEMPLATE=TempHi_{module}
HT9046MX_SOURCE_TEMP_LOW_TEMPLATE=TempLo_{module}
HT9046MX_SOURCE_MODULE_STATUS_TEMPLATE=Status_{module}
HT9046MX_SOURCE_BUSY_TEMPLATE=Busy_{module}
HT9046MX_SOURCE_SV_TEMPLATE=SV_{module}
# Owner-confirmed state mapping: Compressor ON is currently spelled `Run` in
# observed exports; Busy=1 denotes manual/service work and SV=ON is non-running
# Hot/post-Cold bypass context. Only Compressor ON + Busy=0 + SV=Off qualifies
# as the automatic Cold baseline.
HT9046MX_SOURCE_COMPRESSOR_ON_STATUS=Run
HT9046MX_SOURCE_MODULE_ON_STATUS=On
HT9046MX_SOURCE_BUSY_NORMAL_VALUES=0,False,Off
HT9046MX_SOURCE_SV_OFF_VALUES=Off,0,False
# Must be the confirmed IANA timezone of source DATETIME values, not a guess.
HT9046MX_SOURCE_TIMEZONE=
HT9046MX_SOURCE_PRESSURE_UNIT=

# Strict observed-second -> completed one-minute candidate/preview; Dashboard stays 5m.
HT9046MX_PROFILE_WINDOW_CONTRACT=qualified_observed_1m
HT9046MX_QUALIFIED_1M_PREVIEW_ENABLED=false
HT9046MX_SOURCE_EXPECTED_CADENCE_SECONDS=1.0
HT9046MX_QUALIFIED_1M_MINIMUM_COVERAGE=0.95
HT9046MX_QUALIFIED_1M_MAXIMUM_GAP_SECONDS=5.0
HT9046MX_QUALIFIED_1M_LATE_ARRIVAL_SECONDS=30.0
HT9046MX_DASHBOARD_REFRESH_MINUTES=5
HT9046MX_SCORING_INTERVAL_MINUTES=1
# Required in live mode. Labels are accepted only for alerts detected on/after
# this timezone-aware boundary; set it when prospective technician feedback starts.
# HT9046MX_TECHNICIAN_FEEDBACK_START_AT=<APPROVED_ISO8601_WITH_OFFSET>
# `detected_at` is a MySQL DATETIME(6); set its confirmed IANA timezone.
# Do not guess this value. UTC is valid only when the shadow writer stores UTC.
HT9046MX_ALERT_DATETIME_TIMEZONE=

# Built-in candidate calibration: 30 historical days, then a forward-only
# three-day shadow window. This creates immutable candidates only.
HT9046MX_PROFILE_CANDIDATE_ENABLED=false
HT9046MX_PROFILE_HISTORY_DAYS=30
HT9046MX_PROFILE_SHADOW_DAYS=3
HT9046MX_PROFILE_MIN_CALIBRATION_DAYS=7
HT9046MX_PROFILE_MIN_CALIBRATION_WINDOWS=200
HT9046MX_PROFILE_MIN_SHADOW_WINDOWS=200
HT9046MX_PROFILE_RETRY_MIN_NEW_DAYS=3
# Approval is blocked until these evidence versions are declared.
HT9046MX_PROFILE_STATE_CONTRACT_VERSION=
HT9046MX_PROFILE_CONTROLLER_CODEBOOK_VERSION=
HT9046MX_PROFILE_SERVICE_EPOCH_VERSION=

# Candidate-only automation. Commands may create evidence packages but must
# never activate a profile/model.
HT9046MX_PROFILE_CANDIDATE_CRON=0 2 * * *
HT9046MX_MODEL_CANDIDATE_CRON=0 3 * * 0
HT9046MX_SHADOW_SCORE_CRON=* * * * *
HT9046MX_PROFILE_CANDIDATE_COMMAND=
HT9046MX_MODEL_CANDIDATE_COMMAND=
HT9046MX_SHADOW_SCORE_COMMAND=

# Optional frozen Fleet Shadow evidence producer. Use the same Server-local
# store in API and Worker. Setup handoff: deployment/SERVER_WORKER_HANDOFF_20261006.md
HT9046MX_DETECTOR_WORKER_ENABLED=false
HT9046MX_DETECTOR_FLEET_SHADOW_ENABLED=false
HT9046MX_DETECTOR_SHADOW_ONLY=true
# HT9046MX_FLEET_STABLE_STORE=<SERVER_LOCAL_MODEL_DIRECTORY>
# HT9046MX_FLEET_REFERENCE_ROOT=<VERIFIED_PREPARED_STUDY_DIRECTORY>
